{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bazaro",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bazaro-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bazaro-photos"
    }
  ],
  "vars": {
    "APP_URL": "",
    "ADMIN_EMAIL": "",
    "MAIL_FROM": "",
    "OPERATOR_NAME": "Matúš Šturdík",
    "OPERATOR_ADDRESS": "Nová 407, Veľká Mača",
    "OPERATOR_ID": "51628163",
    "CONTACT_EMAIL": "info@bazaro.sk",
    "PUBLIC_INDEXING": "false"
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
